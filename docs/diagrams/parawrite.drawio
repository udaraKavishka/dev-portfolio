<mxfile host="drawio"><diagram id="architecture" name="Architecture"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Writer&lt;/b&gt;" style="shape=label;rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fontFamily=JetBrains Mono;fillColor=none;strokeColor=light-dark(#737373,#8a8a8a);fontColor=light-dark(#404040,#a3a3a3);dashed=1;image=data:image/svg+xml,;imageWidth=20;imageHeight=20;imageAlign=left;imageVerticalAlign=middle;align=left;spacingLeft=34;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="150" height="44" as="geometry"/></mxCell><mxCell id="g2" value="Browser · React + Vite SPA" style="swimlane;startSize=28;rounded=1;arcSize=3;html=1;fontSize=12;fontStyle=1;fontFamily=JetBrains Mono;fillColor=none;swimlaneFillColor=none;strokeColor=light-dark(#d4d4d4,#333333);dashed=1;dashPattern=6 4;fontColor=light-dark(#15803d,#4ade80);align=left;spacingLeft=12;collapsible=0;pointerEvents=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="340" height="700" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Status dot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;opacity:0.8&quot;&gt;in the header&lt;/span&gt;" style="shape=label;rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fontFamily=JetBrains Mono;fillColor=light-dark(#ffffff,#171717);strokeColor=light-dark(#15803d,#4ade80);fontColor=light-dark(#171717,#d4d4d4);image=data:image/svg+xml,;imageWidth=20;imageHeight=20;imageAlign=left;imageVerticalAlign=middle;align=left;spacingLeft=34;spacingRight=8;" vertex="1" parent="g2"><mxGeometry x="170" y="44" width="150" height="52" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;opacity:0.8&quot;&gt;paste text, or upload&lt;br&gt;PDF · DOCX · DOC · MD · MDX · TXT&lt;/span&gt;" style="shape=label;rounded=1;arcSize=12;whiteSpace=wrap;html=1;f